							BTNCS_Execute = "-- MB ON\nlocal function Exp(meno, expr)\n	local tool = comp:FindTool(meno)\n	tool.MotionBlur:SetExpression(expr)\nend\ncomp:FindTool(\"LL\").btnMBON:SetAttrs({INPS_Name = \"运动模糊 开 ✅ \"})\ncomp:FindTool(\"LL\").btnMBOFF:SetAttrs({INPS_Name = \"运动模糊 关\"})\nExp(\"xfMove1\", \"iif(LL.A1>0 and LL.A1<1, 1, 0)\")\nExp(\"xfMove2\", \"iif(LL.A1>0 and LL.A1<1, 1, 0)\")\nExp(\"xfMove3\", \"iif(LL.A1>0 and LL.A1<1, 1, 0)\")\nExp(\"xfMove0\", \"iif(LL.A2>0 and LL.A2<1, 1, 0)\")\nExp(\"xfMove4\", \"iif(LL.A2>0 and LL.A2<1, 1, 0)\")\nExp(\"xfMove5\", \"iif(LL.A2>0 and LL.A2<1, 1, 0)\")\nExp(\"camShake\", \"iif(LL.A2>0 and LL.A2<1, 1, 0)\")\nfor i= 0, 5 do\n	node=comp:FindTool(\"dBlur\"..i)\n	node:SetAttrs({TOOLB_PassThrough = false})\nend\n",
