FindTool(\"xf2\")\nlocal node3b = comp:FindTool(\"DispPap2\")\nlocal node4b = comp:FindTool(\"mgPT2\")\nlocal node5b = comp:FindTool(\"CC2\")\nlocal node6b = comp:FindTool(\"FF2\")\n\nlocal nodes = {node1, node2, node3, node4, node5, node6}\nlocal nodes2 = {node1b, node2b, node3b, node4b, node5b, node6b}\n\nfor i, node in ipairs(nodes) do\n    local currentPassThrough = node:GetAttrs().TOOLB_PassThrough\n    node:SetAttrs({TOOLB_PassThrough = not currentPassThrough})\nend\n\nfor j, node in ipairs(nodes2) do\n    local currentPassThrough = node:GetAttrs().TOOLB_PassThrough\n    node:SetAttrs({TOOLB_PassThrough = not currentPassThrough})\nend", INP_MaxScale = 1, INP_MinScale = 0, INP_MinAllowed = -1000000, LINKID_DataType = "Number", LINKS_Name = "反转转场", }, FFON = { INP_MaxAllowed = 1000000, INP_Integer = false, INPID_InputControl = "ButtonControl", BTNCS_Execute = "FF1.Delay:SetExpression(\"comp.RenderStart\")\nFF2.Delay:SetExpression(\"comp.RenderEnd-1\")\nFF1.Speed=0\nFF2.Speed=0", INP_MaxScale = 1, INP_MinScale = 0, INP_MinAllowed = -1000000, LINKID_DataType = "Number", ICD_Width = 0.490000009536743, LINKS_Name = "冻结帧开启", }, FFOFF = { ICD_Width = 0.490000009536743, INP_Integer = false, LINKID_DataType = "Number", BTNCS_Execute = "FF1.Delay:SetExpression(nil)\nFF2.Delay:SetExpression(nil)\nFF1.Delay=0\nFF2.Delay=0\nFF1.Speed=1\nFF2.Speed=1", INPID_InputControl = "ButtonControl", LINKS_Name = "冻结帧关闭", }, TRCenter = { INP_Integer = false, LINKS_Name = "撕纸中心", INPID_InputControl = "SliderControl", INP_MinScale = 0, LINKID_DataType = "Number", INP_MaxScale = 1, INP_Default = 0.5, }, MirrorEdges = {
